{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TTNDD_OPS Event Catalog",
  "version": "0.2.0",
  "description": "Code-first event catalog extracted from packages/constants/src/events.ts (DOMAIN_EVENTS). Each event follows the naming convention: module.entity_action_past_tense.",
  "envelope": {
    "type": "object",
    "required": [
      "id",
      "orgId",
      "eventType",
      "aggregateId",
      "aggregateType",
      "payload",
      "actorUserId",
      "createdAt"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "Auto-generated event ID"
      },
      "orgId": {
        "type": "string",
        "format": "uuid",
        "description": "Tenant isolation key (RLS)"
      },
      "eventType": {
        "type": "string",
        "description": "One of the event types listed below"
      },
      "aggregateId": {
        "type": "string",
        "format": "uuid",
        "description": "ID of the entity that changed"
      },
      "aggregateType": {
        "type": "string",
        "description": "Entity type name, e.g. Member, Session"
      },
      "payload": {
        "type": "object",
        "description": "Event-specific data (schema varies per event)"
      },
      "actorUserId": {
        "type": "string",
        "format": "uuid",
        "description": "User who triggered the action"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "processedAt": {
        "type": ["string", "null"],
        "format": "date-time"
      }
    }
  },
