generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE: Multi-Tenant Foundation (Module 10)
// ============================================================

model Organization {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String   @unique @db.VarChar(100)
  name             String   @db.VarChar(255)
  fullName         String?  @map("full_name")
  logoUrl          String?  @map("logo_url")
  settings         Json     @default("{}")
  subscriptionPlan String   @default("basic") @map("subscription_plan") @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  branches     Branch[]
  units        Unit[]
  orgMembers   OrgMember[]
  domainEvents DomainEvent[]

  @@map("organizations")
}

model Branch {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String  @map("org_id") @db.Uuid
  code          String  @db.VarChar(50)
  name          String  @db.VarChar(100)
  minAge        Int?    @map("min_age")
  maxAge        Int?    @map("max_age")
  colorTheme    String? @map("color_theme") @db.VarChar(50)
  narrativeName String? @map("narrative_name") @db.VarChar(100)
  settings      Json    @default("{}")

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  units           Unit[]
  orgMembers      OrgMember[]
  rankDefinitions RankDefinition[]
  sessions        Session[]

  @@unique([orgId, code])
  @@map("branches")
}

model Unit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  name         String   @db.VarChar(100)
  totemName    String?  @map("totem_name") @db.VarChar(100)
  unitType     String?  @map("unit_type") @db.VarChar(50)
  parentUnitId String?  @map("parent_unit_id") @db.Uuid
  leaderUserId String?  @map("leader_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  parentUnit   Unit?        @relation("UnitHierarchy", fields: [parentUnitId], references: [id])
  childUnits   Unit[]       @relation("UnitHierarchy")
  orgMembers   OrgMember[]

  @@map("units")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid") @db.VarChar(128)
  email       String?  @unique @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  displayName String?  @map("display_name") @db.VarChar(255)
  avatarUrl   String?  @map("avatar_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  orgMembers   OrgMember[]
  domainEvents DomainEvent[] @relation("EventActor")

  @@map("users")
}

model OrgMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @db.VarChar(50)
  truongLevel    String?  @map("truong_level") @db.VarChar(50)
  branchId       String?  @map("branch_id") @db.Uuid
  unitId         String?  @map("unit_id") @db.Uuid
  memberCode     String?  @map("member_code") @db.VarChar(50)
  joinedDate     DateTime? @map("joined_date") @db.Date
  status         String   @default("active") @db.VarChar(50)
  linkedMemberId String?  @map("linked_member_id") @db.Uuid
  scoutName      String?  @map("scout_name") @db.VarChar(100)
  heroName       String?  @map("hero_name") @db.VarChar(100)
  meta           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])
  linkedMember OrgMember?   @relation("MemberLink", fields: [linkedMemberId], references: [id])
  linkedBy     OrgMember[]  @relation("MemberLink")

  profile            MemberProfile?
  branchHistory      MemberBranchHistory[]
  expTransactions    ExpTransaction[]
  expSummary         MemberExpSummary?
  badges             MemberBadge[]
  redemptions        RewardRedemption[]
  skillProgress       MemberSkillProgress[]
  memberRanks         MemberRank[]
  sessionAttendance   SessionAttendance[]
  eventRegistrations  EventRegistration[]
  courseProgress       MemberCourseProgress[]
  spiritualLogs       SpiritualLog[]
  nguGioiAssessments  NguGioiAssessment[]
  evaluations         Evaluation[]
  memberFees          MemberFee[]

  @@unique([orgId, userId])
  @@map("org_members")
}

// ============================================================
// MODULE 10: Audit Log
// ============================================================

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([orgId, action])
  @@index([orgId, resource, resourceId])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// MODULE 1: HRM (Human Resource Management)
// ============================================================

model MemberProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  orgMemberId     String    @unique @map("org_member_id") @db.Uuid
  fullName        String    @map("full_name") @db.VarChar(255)
  birthDate       DateTime? @map("birth_date") @db.Date
  gender          String?   @db.VarChar(20)
  idCard          String?   @map("id_card") @db.VarChar(50)
  address         String?
  photoUrl        String?   @map("photo_url")
  personalPhone   String?   @map("personal_phone") @db.VarChar(20)
  personalEmail   String?   @map("personal_email") @db.VarChar(255)
  zaloId          String?   @map("zalo_id") @db.VarChar(100)
  guardianName    String?   @map("guardian_name") @db.VarChar(255)
  guardianPhone   String?   @map("guardian_phone") @db.VarChar(20)
  guardianRelation String?  @map("guardian_relation") @db.VarChar(50)
  guardianZalo    String?   @map("guardian_zalo") @db.VarChar(100)
  promiseDate     DateTime? @map("promise_date") @db.Date
  uniformSize     String?   @map("uniform_size") @db.VarChar(20)
  healthNotes     String?   @map("health_notes")
  emergencyContact String?  @map("emergency_contact")
  woodBadgeLevel  String?   @map("wood_badge_level") @db.VarChar(50)
  specializations String[]  @default([])
  joinReason      String?   @map("join_reason")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  orgMember OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("member_profiles")
}

model MemberBranchHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  orgMemberId    String   @map("org_member_id") @db.Uuid
  fromBranchId   String?  @map("from_branch_id") @db.Uuid
  toBranchId     String?  @map("to_branch_id") @db.Uuid
  fromUnitId     String?  @map("from_unit_id") @db.Uuid
  toUnitId       String?  @map("to_unit_id") @db.Uuid
  transitionDate DateTime @map("transition_date") @db.Date
  reason         String?
  approvedBy     String?  @map("approved_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  orgMember OrgMember @relation(fields: [orgMemberId], references: [id])

  @@index([orgId, orgMemberId])
  @@map("member_branch_history")
}

model OrgChartNode {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  nodeType     String   @map("node_type") @db.VarChar(50)
  name         String   @db.VarChar(255)
  parentNodeId String?  @map("parent_node_id") @db.Uuid
  orgMemberId  String?  @map("org_member_id") @db.Uuid
  positionTitle String? @map("position_title") @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  parentNode  OrgChartNode?  @relation("OrgChartHierarchy", fields: [parentNodeId], references: [id])
  childNodes  OrgChartNode[] @relation("OrgChartHierarchy")

  @@index([orgId])
  @@map("org_chart_nodes")
}

// ============================================================
// MODULE 9: Reward Engine (EXP, Badges, Leaderboard)
// ============================================================

model ExpConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(200)
  sourceModule String   @map("source_module") @db.VarChar(100)
  actionName   String   @map("action_name") @db.VarChar(255)
  expAmount    Int      @map("exp_amount")
  maxPerDay    Int      @default(-1) @map("max_per_day")
  maxPerWeek   Int      @default(-1) @map("max_per_week")
  isActive     Boolean  @default(true) @map("is_active")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([orgId, eventType])
  @@map("exp_configs")
}

model ExpTransaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  orgMemberId     String    @map("org_member_id") @db.Uuid
  transactionType String    @map("transaction_type") @db.VarChar(20)
  expAmount       Int       @map("exp_amount")
  eventType       String?   @map("event_type") @db.VarChar(200)
  sourceModule    String?   @map("source_module") @db.VarChar(100)
  sourceEntityId  String?   @map("source_entity_id") @db.Uuid
  deductionReason String?   @map("deduction_reason")
  balanceAfter    Int?      @map("balance_after")
  recordedBy      String?   @map("recorded_by") @db.Uuid
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  orgMember OrgMember @relation(fields: [orgMemberId], references: [id])

  @@index([orgId, orgMemberId])
  @@index([orgId, createdAt])
  @@map("exp_transactions")
}

model MemberExpSummary {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  orgMemberId  String   @unique @map("org_member_id") @db.Uuid
  totalExp     Int      @default(0) @map("total_exp")
  availableExp Int      @default(0) @map("available_exp")
  tier1Count   Int      @default(0) @map("tier_1_count")
  tier2Count   Int      @default(0) @map("tier_2_count")
  tier3Count   Int      @default(0) @map("tier_3_count")
  tier4Count   Int      @default(0) @map("tier_4_count")
  penaltyCount Int      @default(0) @map("penalty_count")
  lastUpdated  DateTime @default(now()) @updatedAt @map("last_updated") @db.Timestamptz()

  orgMember OrgMember @relation(fields: [orgMemberId], references: [id])

  @@index([orgId])
  @@map("member_exp_summary")
}

model BadgeDefinition {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String  @map("org_id") @db.Uuid
  badgeCode    String  @map("badge_code") @db.VarChar(100)
  name         String  @db.VarChar(255)
  description  String?
  badgeType    String? @map("badge_type") @db.VarChar(50)
  imageUrl     String  @map("image_url")
  rarity       String  @default("common") @db.VarChar(20)
  triggerEvent String? @map("trigger_event") @db.VarChar(200)
  triggerConfig Json   @default("{}") @map("trigger_config")
  expReward    Int     @default(0) @map("exp_reward")
  isAutoAward  Boolean @default(true) @map("is_auto_award")

  memberBadges MemberBadge[]

  @@unique([orgId, badgeCode])
  @@map("badge_definitions")
}

model MemberBadge {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  orgMemberId   String   @map("org_member_id") @db.Uuid
  badgeId       String   @map("badge_id") @db.Uuid
  earnedAt      DateTime @default(now()) @map("earned_at") @db.Timestamptz()
  sourceEventId String?  @map("source_event_id") @db.Uuid
  notes         String?

  orgMember OrgMember       @relation(fields: [orgMemberId], references: [id])
  badge     BadgeDefinition @relation(fields: [badgeId], references: [id])

  @@unique([orgMemberId, badgeId])
  @@index([orgId])
  @@map("member_badges")
}

model RewardItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  name              String    @db.VarChar(255)
  description       String?
  costExp           Int       @map("cost_exp")
  category          String?   @db.VarChar(100)
  imageUrl          String?   @map("image_url")
  quantityAvailable Int       @default(-1) @map("quantity_available")
  isActive          Boolean   @default(true) @map("is_active")
  validUntil        DateTime? @map("valid_until") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  redemptions RewardRedemption[]

  @@index([orgId])
  @@map("reward_items")
}

model RewardRedemption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  orgMemberId String   @map("org_member_id") @db.Uuid
  rewardId    String   @map("reward_id") @db.Uuid
  expSpent    Int      @map("exp_spent")
  status      String   @default("pending") @db.VarChar(50)
  approvedBy  String?  @map("approved_by") @db.Uuid
  redeemedAt  DateTime @default(now()) @map("redeemed_at") @db.Timestamptz()

  orgMember OrgMember  @relation(fields: [orgMemberId], references: [id])
  reward    RewardItem @relation(fields: [rewardId], references: [id])

  @@index([orgId])
  @@map("reward_redemptions")
}

model LeaderboardSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  scope        String   @db.VarChar(50)
  scopeId      String?  @map("scope_id") @db.Uuid
  period       String?  @db.VarChar(50)
  snapshotDate DateTime @map("snapshot_date") @db.Date
  rankings     Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([orgId, scope, snapshotDate])
  @@map("leaderboard_snapshots")
}

// ============================================================
// MODULE 8A: Scout Core (Đẳng thứ & Kỹ năng)
// ============================================================

model RankDefinition {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String  @map("org_id") @db.Uuid
  branchId      String  @map("branch_id") @db.Uuid
  rankCode      String  @map("rank_code") @db.VarChar(100)
  rankName      String  @map("rank_name") @db.VarChar(255)
  narrativeName String? @map("narrative_name") @db.VarChar(255)
  rankOrder     Int     @map("rank_order")
  description   String?
  iconUrl       String? @map("icon_url")
  badgeImageUrl String? @map("badge_image_url")
  minExp        Int     @default(0) @map("min_exp")

  branch      Branch       @relation(fields: [branchId], references: [id])
  memberRanks MemberRank[]

  @@unique([orgId, branchId, rankCode])
  @@map("rank_definitions")
}

model SkillGroup {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String  @map("org_id") @db.Uuid
  branchId      String? @map("branch_id") @db.Uuid
  name          String  @db.VarChar(255)
  narrativeName String? @map("narrative_name") @db.VarChar(255)
  description   String?
  icon          String? @db.VarChar(100)
  color         String? @db.VarChar(20)
  orderIndex    Int     @default(0) @map("order_index")

  skills Skill[]

  @@map("skill_groups")
}

model Skill {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  skillGroupId    String   @map("skill_group_id") @db.Uuid
  branchId        String?  @map("branch_id") @db.Uuid
  rankId          String?  @map("rank_id") @db.Uuid
  skillCode       String   @map("skill_code") @db.VarChar(100)
  name            String   @db.VarChar(255)
  narrativeName   String?  @map("narrative_name") @db.VarChar(255)
  description     String?
  levels          Json
  maxLevel        Int      @default(4) @map("max_level")
  iconUrl         String?  @map("icon_url")
  isRequired      Boolean  @default(false) @map("is_required")
  requiredForRankId String? @map("required_for_rank_id") @db.Uuid
  expPerLevel     Int      @default(10) @map("exp_per_level")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  skillGroup      SkillGroup          @relation(fields: [skillGroupId], references: [id])
  memberProgress  MemberSkillProgress[]

  @@map("skills")
}

model MemberSkillProgress {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  orgMemberId      String    @map("org_member_id") @db.Uuid
  skillId          String    @map("skill_id") @db.Uuid
  currentLevel     Int       @default(0) @map("current_level")
  criteriaCompleted Json     @default("{}") @map("criteria_completed")
  verifiedLevels   Json      @default("{}") @map("verified_levels")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz()

  orgMember OrgMember @relation(fields: [orgMemberId], references: [id])
  skill     Skill     @relation(fields: [skillId], references: [id])

  @@unique([orgMemberId, skillId])
  @@map("member_skill_progress")
}

model MemberRank {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  orgMemberId String    @map("org_member_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  rankId      String    @map("rank_id") @db.Uuid
  status      String    @default("in_progress") @db.VarChar(50)
  startedAt   DateTime? @map("started_at") @db.Date
  completedAt DateTime? @map("completed_at") @db.Date
  verifiedBy  String?   @map("verified_by") @db.Uuid
  ceremonyDate DateTime? @map("ceremony_date") @db.Date
  notes       String?

  orgMember OrgMember      @relation(fields: [orgMemberId], references: [id])
  rank      RankDefinition @relation(fields: [rankId], references: [id])

  @@unique([orgMemberId, branchId, rankId])
  @@map("member_ranks")
}

// ============================================================
// MODULE 8B: Sessions & Attendance
// ============================================================

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  title             String    @db.VarChar(500)
  sessionDate       DateTime  @map("session_date") @db.Date
  startTime         String?   @map("start_time") @db.VarChar(10)
  endTime           String?   @map("end_time") @db.VarChar(10)
  location          String?   @db.VarChar(255)
  sessionType       String?   @map("session_type") @db.VarChar(50)
  theme             String?   @db.VarChar(255)
  pillarDaoDuc      String?   @map("pillar_dao_duc")
  pillarPhuongPhap  String?   @map("pillar_phuong_phap")
  pillarGiaoDuc     String?   @map("pillar_giao_duc")
  lessonPlan        Json?     @map("lesson_plan")
  materials         Json?
  debriefNotes      String?   @map("debrief_notes")
  energyRating      Int?      @map("energy_rating")
  engagementRating  Int?      @map("engagement_rating")
  status            String    @default("planned") @db.VarChar(50)
  createdBy         String?   @map("created_by") @db.Uuid
  expReward         Int       @default(5) @map("exp_reward")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  branch     Branch              @relation(fields: [branchId], references: [id])
  attendance SessionAttendance[]

  @@index([orgId, sessionDate])
  @@map("sessions")
}

model SessionAttendance {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  orgMemberId   String    @map("org_member_id") @db.Uuid
  checkInTime   DateTime? @map("check_in_time") @db.Timestamptz()
  checkOutTime  DateTime? @map("check_out_time") @db.Timestamptz()
  status        String    @default("present") @db.VarChar(50)
  excusedReason String?   @map("excused_reason")
  notedBy       String?   @map("noted_by") @db.Uuid

  session   Session   @relation(fields: [sessionId], references: [id])
  orgMember OrgMember @relation(fields: [orgMemberId], references: [id])

  @@unique([sessionId, orgMemberId])
  @@map("session_attendance")
}

model AnnualProgram {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  year          Int
  title         String?  @db.VarChar(255)
  monthlyThemes Json?    @map("monthly_themes")
  objectives    Json?
  status        String   @default("draft") @db.VarChar(50)
  approvedBy    String?  @map("approved_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([orgId, branchId, year])
  @@map("annual_programs")
}

// ============================================================
// MODULE 8C: Events & Camps
// ============================================================

model Event {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  title               String    @db.VarChar(500)
