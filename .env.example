# TTNDD_Ops API — Environment Variables
# Copy to .env and fill in values

# ── Database ──
DATABASE_URL=postgresql://ttndd:password@localhost:5432/ttndd_ops?schema=public
# For Prisma shadow DB (migrations):
# DIRECT_URL=postgresql://ttndd:password@localhost:5432/ttndd_ops?schema=public

# ── Auth ──
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Google Cloud ──
GCS_BUCKET=ttndd-ops-files
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Server ──
PORT=8080
NODE_ENV=development

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Feature Flags ──
ENABLE_NOTIFICATIONS=true
ENABLE_FILE_STORAGE=true
ENABLE_DATA_IMPORT=true

# ── Logging ──
LOG_LEVEL=debug
LOG_FORMAT=json
