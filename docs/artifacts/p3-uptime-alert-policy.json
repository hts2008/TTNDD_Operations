{
  "displayName": "TTNDD production uptime failures",
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "API or Web uptime check failed for TTNDD production. Follow docs/runbooks/p3-production-ops-runbook.md rollback section.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "API health check failed",
      "conditionThreshold": {
        "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.label.check_id=\"ttndd-api-health-rwwLmlKjrKU\" AND resource.type=\"uptime_url\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_NEXT_OLDER"
          }
        ],
        "comparison": "COMPARISON_LT",
        "thresholdValue": 1,
        "duration": "60s",
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "Web home check failed",
      "conditionThreshold": {
        "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.label.check_id=\"ttndd-web-home-aVbafikZSSA\" AND resource.type=\"uptime_url\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_NEXT_OLDER"
          }
        ],
        "comparison": "COMPARISON_LT",
        "thresholdValue": 1,
        "duration": "60s",
        "trigger": {
          "count": 1
        }
      }
    }
  ]
}
